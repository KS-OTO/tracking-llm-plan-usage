# ============================================================
# LLM 用量监控 · 环境变量主模板
#
# 用法：cp .env.example .env，再把需要的平台变量改成真实值。
# 变量全集以 `server/env-vars.ts` 的 SERVER_ENV_VARS 为准。
#
# 三份文件的分工（只维护一套变量名，避免各自漂移）：
#   .env.example         ← 你在这里：完整说明 / 获取地址 / 排错
#   .dev.vars.example      Cloudflare Workers：同变量、同顺序，只讲 Workers 差异
#   .env                   本机真实值（gitignored）；未配置的变量保持注释即可
#
# 新增平台时必须同步三处：env-vars.ts 登记、本文件、.dev.vars.example。
# `server/env-vars.test.ts` 会校验变量覆盖与两份示例的顺序一致性。
# ------------------------------------------------------------
#
# 一眼看懂：每个平台属于哪个 Tab、需要哪些变量
#
#   平台                 归属 Tab      必需变量
#   DeepSeek             余额          DEEPSEEK_API_KEY
#   OpenRouter           余额          OPENROUTER_API_KEY
#   StepFun              余额          STEPFUN_API_KEY
#   SiliconFlow          余额          SILICONFLOW_API_KEY（+ 可选 SILICONFLOW_SITE）
#   Novita AI            余额          NOVITA_API_KEY
#   智谱 GLM             余额 + 套餐   ZHIPU_API_KEY（+ 可选团队版组织/项目）
#   模力方舟 Gitee AI    余额          GITEE_AI_API_KEY（+ 可选 SESSION_COOKIE 查代金券）
#   百度千帆             余额          BAIDU_ACCESS_KEY_ID + BAIDU_SECRET_KEY
#   火山方舟             套餐          VOLC_ACCESS_KEY_ID + VOLC_SECRET_KEY
#   阿里云百炼           余额 + 套餐   ALIYUN_ACCESS_KEY_ID + ALIYUN_SECRET_KEY（+ 可选 TOKENPLAN_COOKIE）
#   Kimi For Coding      套餐          KIMI_API_KEY
#   MiniMax              套餐          MINIMAX_API_KEY（+ 可选 MINIMAX_SITE）
#   OpenCode Go          套餐          OPENCODE_GO_API_KEY
#   Command Code         套餐          COMMAND_CODE_API_KEY
#   ZenMux               套餐          ZENMUX_API_KEY（+ 可选 ZENMUX_BASE_URL）
#   Sub2API              余额          SUB2API_BASE_URL + SUB2API_API_KEY
#   New API              余额 + 套餐   NEWAPI_BASE_URL + NEWAPI_TOKEN
#
# ------------------------------------------------------------
# 多账号与别名
#
#   第 1 组用基础变量名；第 N 组加 _N 后缀（连续编号，断号即停）。
#   成对凭据同编号成组：VOLC_ACCESS_KEY_ID_2 + VOLC_SECRET_KEY_2。
#
#   *_LABEL / *_LABEL_N 按同序号与凭据配对，只影响卡片标题，不参与鉴权。
#   OPENCODE_GO_API_KEY_2=sk-xxxx
#   OPENCODE_GO_LABEL_2=后端团队专用
#
# ⚠️ 本地 .env 会做 $VAR 展开：值里的字面 $ 必须写成 \$（加引号无效）。
#    平台面板（Vercel / EdgeOne / Workers）相反：直接粘原值，不要加反斜杠。
# ------------------------------------------------------------

# ============================================================
# 一、余额账户（→「余额账户」Tab）
# ============================================================

# ---------- DeepSeek ----------
# 用途：GET /user/balance 查询总余额 / 充值 / 赠金（CNY / USD）
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_LABEL=

# ---------- OpenRouter ----------
# 用途：credits + key 元数据；余额 / 限额剩余 / 今日用量
# 获取：https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_LABEL=

# ---------- StepFun ----------
# 用途：GET /v1/accounts 查询余额（CNY）；现金 / 代金券余额进详情
# 获取：https://platform.stepfun.com/
STEPFUN_API_KEY=
# STEPFUN_LABEL=

# ---------- SiliconFlow ----------
# 用途：GET /v1/user/info 查询余额；国际站金额为 USD
# 获取：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=
# 站点（可选）：cn=国内站（默认，CNY），global=国际站（USD）。按 Key 同序号配对。
# SILICONFLOW_SITE=cn
# SILICONFLOW_LABEL=

# ---------- Novita AI ----------
# 用途：GET /v3/user/balance；上游金额单位 0.0001 USD，服务端已折算为 USD
# 获取：https://novita.ai/
NOVITA_API_KEY=
# NOVITA_LABEL=

# ---------- 智谱 GLM（余额 + Coding Plan） ----------
# 用途：Coding Plan 额度（裸 Key）+ 控制台余额 / 资源包（Bearer）
# 获取：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=xxxxx.xxxxx
# ZHIPU_LABEL=
# 团队版（可选）：同一把 Key + 组织 / 项目两个请求头，查询 ?type=2 的团队套餐额度。
# 两者缺一不可；个人版留空即可。按 Key 同序号配对。
# ZHIPU_ORGANIZATION_ID=
# ZHIPU_PROJECT_ID=

# ---------- 模力方舟（Gitee AI） ----------
# 用途：GET /v1/tokens/packages/balance 查询资源包余额 / 已用 / 明细（Bearer）
# 获取：https://ai.gitee.com → 访问令牌
GITEE_AI_API_KEY=UC03<32位访问令牌>
# GITEE_LABEL=
# 代金券（可选）：ai.gitee.com 登录后的整行 Cookie；Token 无权限查代金券。
# 获取：浏览器 DevTools → Application → Cookies → 复制整行 Cookie。
# 平台面板拒绝空格 / 分号时，先 encodeURIComponent 再粘贴；服务端自动兼容。
# 安全：Cookie 等同登录态，只放服务端。
# GITEE_AI_SESSION_COOKIE=

# ---------- 百度智能云千帆 ----------
# 用途：量包列表 / TPM 配额 / 近 7 天调用概览（BCE bce-auth-v1 AK/SK）
# 获取：https://console.bce.baidu.com/iam/#/iam/accesslist
# 权限：建议子账号 + QianfanServiceReadAccessPolicy 只读
BAIDU_ACCESS_KEY_ID=ALTAKxxxx
BAIDU_SECRET_KEY=xxxx
# BAIDU_LABEL=

# ---------- Sub2API（自托管网关） ----------
# 用途：GET {SUB2API_BASE_URL}/v1/usage；站点地址 + 模型调用 API Key 成对配置。
# 地址带不带 /v1 都行；不限量订阅只显示套餐名。
SUB2API_BASE_URL=https://sub.example.com/
SUB2API_API_KEY=
# SUB2API_LABEL=

# ============================================================
# 二、套餐订阅（→「套餐订阅」Tab）
# ============================================================

# ---------- 火山方舟（Volcengine Ark） ----------
# 用途：管控面 API（v4 签名）查询 Agent Plan / Coding Plan 额度与推理用量
# 获取：https://console.volcengine.com/iam/keymanage
# 权限：推荐 IAM 子用户 + 方舟只读权限
VOLC_ACCESS_KEY_ID=AKLTxxxx
VOLC_SECRET_KEY=xxxx
# VOLC_LABEL=

# ---------- 阿里云百炼（资源包 + Token Plan） ----------
# 资源包：BSS 费用中心（AK/SK）
# Token Plan：Model Studio ROA；组织 / 座席区块需 AliyunTokenPlanReadOnlyAccess
# 获取：https://ram.console.aliyun.com/manage/ak
ALIYUN_ACCESS_KEY_ID=LTAIxxxx
ALIYUN_SECRET_KEY=xxxx
# ALIYUN_LABEL=
#
# 个人版用量（可选，推荐）：只需控制台会话 Cookie，无需 AK/SK、无需 RAM 授权。
#   1. 登录 https://bailian.console.aliyun.com
#   2. DevTools → Application → Cookies → bailian.console.aliyun.com
#   3. 国内站：复制 login_aliyunid_ticket 的“值”即可（服务端会自动补名字）
#      国际站：复制 home.qwencloud.com 的完整 Cookie 请求头
#
# ⚠️ ticket 值含字面 $；本地 .env 必须写成 \$，否则被 $VAR 展开静默截断。
#    加引号无效，只有 \$ 有效。平台面板直接粘原值，不要反斜杠。
#
# ALIYUN_TOKENPLAN_COOKIE=
# 区域（可选，全局生效）：cn=百炼北京站（默认），intl=QwenCloud 国际站（新加坡）。
# 国际站只支持 Cookie 通道（AK/SK 仅国内站）。
# ALIYUN_TOKENPLAN_REGION=cn
# 只有 Cookie、没有 AK/SK 的账号，别名用这个（ALIYUN_LABEL 找不到配对项）。
# ALIYUN_TOKENPLAN_LABEL=

# ---------- Kimi For Coding ----------
# 用途：GET /coding/v1/usages 查询 5 小时 / 每周额度
# 获取：https://platform.moonshot.cn
KIMI_API_KEY=
# KIMI_LABEL=

# ---------- MiniMax ----------
# 用途：GET /v1/token_plan/remains 查询滚动窗口 / 每周额度
# 获取：https://platform.minimaxi.com
MINIMAX_API_KEY=
# 站点（可选）：cn=国内站（默认，api.minimaxi.com），global=国际站（api.minimax.io）。
# MINIMAX_SITE=cn
# MINIMAX_LABEL=

# ---------- OpenCode Go ----------
# 用途：GET /zen/go/v1/usage；rolling 5h / weekly 7d / monthly 三种窗口
# 获取：https://opencode.ai
OPENCODE_GO_API_KEY=
# 别名（多 Key 时强烈建议；否则只看到 sk-EXAM****PLE9 掩码）
# OPENCODE_GO_LABEL=

# ---------- Command Code ----------
# 用途：/alpha/whoami + /alpha/billing/credits；5h / 周窗口 + credit 余额
# 获取：https://commandcode.ai/
COMMAND_CODE_API_KEY=
# COMMAND_CODE_LABEL=

# ---------- ZenMux ----------
# 用途：GET {ZENMUX_BASE_URL}；5 小时 / 7 天额度（百分比 + USD 金额）
# 获取：https://zenmux.ai/
ZENMUX_API_KEY=
# 额度端点（可选，默认 https://zenmux.ai/api/v1）；按 Key 同序号配对。
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# ZENMUX_LABEL=

# ---------- New API（自托管网关） ----------
# 用途：订阅额度（→套餐订阅）或钱包余额（→余额账户）。
# 站点地址 + 系统访问令牌成对配置；令牌不是 sk- 模型调用密钥。
# 获取：站点「个人设置 → 安全设置 → 系统访问令牌」
# 文档：https://docs.newapi.ai/zh/docs/api/management/auth
#
# 误填 sk- 密钥不会报错，但会静默退化到账单接口（只有钱包余额，无用户名与模型明细）。
# NEWAPI_BASE_URL=https://ai.example.com/
# NEWAPI_TOKEN=
# 管理员代查他人数据时填（对应请求头 New-Api-User）；个人自查可省略。
# NEWAPI_USER_ID=
# 例如：主力站
# NEWAPI_LABEL=

# ============================================================
# 三、服务监听（仅 Bun 生产模式；Workers / Vercel 无效）
# ============================================================
# 默认 127.0.0.1:8787 仅本机可访问；0.0.0.0 需自行加防火墙 / 鉴权
# HOST=0.0.0.0
# PORT=8787

# ============================================================
# 四、站点自定义（全部可选，只影响外观与刷新节奏，不参与鉴权）
# ============================================================
# SITE_NAME：导航栏品牌 + 浏览器标题；显式留空 = 只显示 Logo。
# SITE_LOGO_URL / SITE_LOGO_URL_DARK：明亮 / 暗黑 Logo；暗色不配则沿用明亮图。
#   必须是透明底、https；加载失败会自动换另一套，不会留破图。
# SITE_FAVICON_URL：标签页图标；不配则用 /favicon.ico。
# REFRESH_INTERVAL_SECONDS：自动刷新秒数（默认 180，范围 10–3600）。
# SITE_NAME=内部用量面板
# SITE_LOGO_URL=https://cdn.example.com/logo.svg
# SITE_LOGO_URL_DARK=https://cdn.example.com/logo-dark.svg
# SITE_FAVICON_URL=https://cdn.example.com/favicon.png
# REFRESH_INTERVAL_SECONDS=180