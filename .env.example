# ============================================================
# LLM 用量监控 · 环境变量示例
#
# 用法：cp .env.example .env，然后把占位值换成真实值（.env 已 gitignore）。
# 本文件同时也是 Vercel / EdgeOne / 服务器面板填变量时的参考。
#
# 三份文档的分工（同一段说明只在一处维护，避免各自抄一份后漂移）：
#   .env.example        ← 你在这里：**主模板**，变量最全、说明最详细
#   .dev.vars.example     Cloudflare Workers 版：**同样的变量集合 + 同样的顺序**，
#                         只额外讲 Workers 专属差异（怎么配、转义规则有什么不同）
#   .env                  本机真实值（gitignored、不入库），分组顺序与本文件一致
#
# 变量全集以 `server/env-vars.ts` 的 SERVER_ENV_VARS 为准。
# `server/env-vars.test.ts` 会断言「两份 example 都覆盖全集且顺序一致」，
# 所以**新增平台时三处都要动**：env-vars.ts 登记、本文件补说明、.dev.vars.example 同步。
#
# ------------------------------------------------------------
# 多账号：第 1 组用基础变量名，第 N 组加 _N 后缀（连续编号，**断号即停**）。
#   成对凭据同编号成组：VOLC_ACCESS_KEY_ID_2 + VOLC_SECRET_KEY_2。
# 账号别名（可选，多 Key 时强烈建议）：*_LABEL / *_LABEL_N 按**同序号**与凭据配对，
#   卡片主标题显示别名、Key 掩码退居次要位置；别名只影响展示，不参与鉴权。
#   OPENCODE_GO_API_KEY_2=sk-xxxx
#   OPENCODE_GO_LABEL_2=后端团队专用
#
# 页面分区（凭据决定卡片出现在哪个 Tab）：
#   余额类  → 「余额账户」Tab：DeepSeek / OpenRouter / 智谱余额 / Gitee 资源包 …
#   套餐类  → 「套餐订阅」Tab：Kimi For Coding / MiniMax / OpenCode Go
#   New API → 按语义拆卡（订阅额度归「套餐订阅」、钱包归「余额账户」）
#
# ⚠️ 本地 .env 会做 $VAR 变量展开：值里的字面 $ 必须写成 \$（**加引号无效**）。
#    平台面板（Vercel / EdgeOne / Workers）相反：直接粘原值，**不要**加反斜杠。
# ------------------------------------------------------------

# ---------- DeepSeek ----------
# 用途：GET /user/balance 查询总余额 / 充值 / 赠金（CNY / USD）
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_LABEL=

# ---------- 火山方舟（Volcengine Ark）----------
# 用途：管控面 API（v4 签名）查询 Agent Plan / Coding Plan 额度与推理用量
# 获取：https://console.volcengine.com/iam/keymanage（推荐 IAM 子用户 + 方舟只读权限）
VOLC_ACCESS_KEY_ID=AKLTxxxx
VOLC_SECRET_KEY=xxxx
# VOLC_LABEL=

# ---------- 智谱 GLM（Zhipu BigModel）----------
# 用途：Coding Plan 套餐额度（裸 Key 鉴权）+ 控制台余额 / 资源包（Bearer）
# 获取：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=xxxxx.xxxxx
# ZHIPU_LABEL=

# ---------- 阿里云百炼（Aliyun）----------
# 用途：Token Plan（Model Studio ROA）+ Token 资源包（BSS 费用中心）
# 获取：https://ram.console.aliyun.com/manage/ak（推荐 RAM 子用户 + 只读权限）
# 权限：Token Plan 组织 / 座席区块需 AliyunTokenPlanReadOnlyAccess
ALIYUN_ACCESS_KEY_ID=LTAIxxxx
ALIYUN_SECRET_KEY=xxxx
# ALIYUN_LABEL=

# 阿里云百炼 Token Plan · **个人版**用量（可选，推荐）
# 只需百炼控制台的会话 Cookie，**无需 AK/SK、无需任何 RAM 授权**：
#   1. 登录 https://bailian.console.aliyun.com
#   2. DevTools → Application → Cookies → bailian.console.aliyun.com
#   3. 复制 `login_aliyunid_ticket` 的**值**（粘值即可，别粘整段 Cookie 头）
#
# ⚠️ 该 ticket 值含字面 $（形如 …EXAMPLEtika1b2$FAKE90*…），而 .env 会做 $VAR 展开：
#    未转义时那两段会被当成变量名**静默吃空**，且报错与「会话过期」完全同形、极难排查。
#    加引号（"…" / '…'）无效，**只有 \$ 有效**。
#    ❌ ALIYUN_TOKENPLAN_COOKIE=…EXAMPLEtika1b2$FAKE90*…
#    ✅ ALIYUN_TOKENPLAN_COOKIE=…EXAMPLEtika1b2\$FAKE90*…
#    平台面板（Vercel / EdgeOne / Workers）相反：直接粘原值，不要加反斜杠。
#
# 有效期约数周，过期后 UI 提示重新复制；多账号用 _2 / _3 与 AK/SK 同序号配对。
# ALIYUN_TOKENPLAN_COOKIE=
# 个人版账号别名（可选）：**没有 AK/SK 时 ALIYUN_LABEL 找不到配对项、别名会被忽略**，
# 只有 Cookie 的账号请用下面这个变量。
# ALIYUN_TOKENPLAN_LABEL=
# 若不使用 Cookie，也可改用 AK/SK 路径查个人版，但需 RAM 自定义策略授予
# modelstudio:GenerateCLIAccessToken（详见 README「阿里云百炼 Token Plan」）。

# ---------- 模力方舟（Gitee AI）----------
# 用途：GET /v1/tokens/packages/balance 查询资源包余额 / 已用 / 明细（Bearer Token）
# 获取：https://ai.gitee.com → 访问令牌
GITEE_AI_API_KEY=UC03<32位访问令牌>
# GITEE_LABEL=

# 代金券查询（可选）：ai.gitee.com 登录后的会话 Cookie
# 用途：查内部接口 /api/pay/{ns}/wallet、/coupons 拿代金券余额与明细；
#       Token 无权限（Bearer 会 401），必须用登录 Cookie。
# 获取：登录 https://ai.gitee.com → DevTools → Application → Cookies → 复制整行 Cookie
# 格式：本地 .env 直接粘贴原文（含空格 / 分号均可）；
#       EdgeOne Makers EnvVars 拒绝空格 / 分号 / 换行 → 须先编码再粘贴：
#         浏览器控制台运行 console.log(encodeURIComponent('整行Cookie'))，复制输出粘贴
#       服务端两种格式自动兼容（探测到编码即解码）。
# 有效期：约 30 天；过期后 UI 显示「代金券查询失败：Cookie 已过期」，重新登录复制即可，
#         资源包余额查询（Bearer）不受影响。
# 安全：Cookie = 完整登录态，等同账号密码，只放服务端环境变量，绝不入库 / 下发浏览器。
# GITEE_AI_SESSION_COOKIE=user_locale=zh-CN; __Secure-next-auth.session-token=xxxx-xxxx

# ---------- 百度智能云千帆（Baidu Qianfan）----------
# 用途：千帆 OpenAPI（量包列表 / TPM 配额 / 近 7 天调用概览，BCE bce-auth-v1 AK/SK 签名）
# 获取：https://console.bce.baidu.com/iam/#/iam/accesslist
# 权限：建议子账号 + QianfanServiceReadAccessPolicy 只读
BAIDU_ACCESS_KEY_ID=ALTAKxxxx
BAIDU_SECRET_KEY=xxxx
# BAIDU_LABEL=

# ---------- 余额类（→「余额账户」Tab）----------
# 可选，配置哪个显示哪个。卡片只显示余额，总额 / 已用 / 备注在「详情」弹窗内。
# OpenRouter：https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_LABEL=

# ---------- 扩展平台 · 套餐类（→「套餐订阅」Tab）----------
# 按窗口计的订阅额度，卡片只显示窗口进度条，账号身份与窗口明细在「详情」弹窗内。
# Kimi For Coding：https://platform.moonshot.cn
KIMI_API_KEY=
# KIMI_LABEL=
# MiniMax：https://platform.minimaxi.com
MINIMAX_API_KEY=
# MINIMAX_LABEL=
# OpenCode Go（rolling 5h / weekly 7d / monthly 30d 三种窗口）：https://opencode.ai
# 上游限流时该窗口会同时报 percent=100 + status=rate-limited，面板单独标注「上游限流中」。
OPENCODE_GO_API_KEY=
# 别名（可选，一个平台挂多个 Key 时强烈建议配，否则只看到 sk-EXAM****PLE9 这种掩码）
# OPENCODE_GO_LABEL=前端团队专用订阅

# ---------- New API（自托管大模型网关）----------
# 站点地址 + **系统访问令牌**成对配置；管理接口优先、账单接口回落。
#
# NEWAPI_TOKEN 填的是**系统访问令牌**，不是 `sk-` 开头的模型调用密钥：
#   1. 登录你的 New API 站点
#   2. 「个人设置 → 安全设置 → 系统访问令牌」→ 生成
#   3. 把生成的令牌整串粘到 NEWAPI_TOKEN
#   官方文档：https://docs.newapi.ai/zh/docs/api/management/auth
#
# 系统访问令牌能读**管理接口**，字段最全：用户名 / 分组 / 按模型用量 / 订阅模式判定，
# 以及站点自己的额度单位（站点用 USD 之外的币种时也能显示正确单位）。
# 误填 `sk-` 密钥不会报错，但会静默退化到账单接口（只有钱包余额，没有用户名与模型明细）。
#
# ⚠️ 401 有两种：令牌**不认识**（AUTH_UNAUTHORIZED）与令牌**认识但账号被停用**
# （AUTH_USER_DISABLED / "User has been banned"）。后者令牌本身有效，去站点后台解封即可，
# 卡片会直接把这句告诉你 —— 不要因为报错就重置令牌。
#
# 多站点按 _2 / _3 追加；NEWAPI_USER_ID / NEWAPI_LABEL 与 BASE_URL 同序号配对。
NEWAPI_BASE_URL=https://ai.example.com/
NEWAPI_TOKEN=
# 管理员代查他人数据时填，个人自查可省略（对应请求头 New-Api-User）
# NEWAPI_USER_ID=
# NEWAPI_LABEL=主力站

# ---------- 服务监听（仅 Bun 生产模式；Workers / Vercel 无效）----------
# 默认 127.0.0.1:8787 仅本机可访问；0.0.0.0 需自行加防火墙 / 鉴权
# HOST=0.0.0.0
# PORT=8787

# ---------- 站点自定义（全部可选，只影响外观与刷新节奏，不参与鉴权）----------
# 为什么走环境变量而不是前端构建期变量：同一份构建产物要跑在 Bun / Cloudflare
# Workers / EdgeOne / Vercel 四种宿主上，而部署流程让用户在平台面板里配的就是
# **运行时**变量。用构建期变量会变成「改个站点名要重新构建并重传产物」。
#
# SITE_NAME：导航栏品牌位 + 浏览器标签页标题（默认「LLM 用量监控」）
#   显式留空（`SITE_NAME=`）= 品牌位**只显示 Logo**，适合 Logo 本身已是
#   「图形 + 品牌名」完整字标的情况。注意「留空」≠「不配」：不配会显示默认名。
# SITE_LOGO_URL：明亮模式 Logo 地址，未配置则只显示文字标题
# SITE_LOGO_URL_DARK：暗黑模式专用 Logo 地址；不配则暗黑模式沿用 SITE_LOGO_URL
#   深色字标落在深色导航上会糊成一片，字标型 Logo 建议两套都配。
#   ⚠️ Logo **必须是透明底**：自带不透明底色的图会在导航条上浮出一个矩形
#   （实测 rgb(22,23,27) 的图落在 rgb(36,36,36) 的暗色导航上，边界肉眼可见）。
# SITE_FAVICON_URL：标签页图标地址，未配置则保留自带的 /favicon.ico
#   三者都由浏览器直接加载（不经服务端代理），因此**不受 CORS 限制**；
#   但必须是 https —— http 资源在 https 页面上会被按混合内容拦掉。
#   Logo 高度固定、宽度自适应（桌面 / 平板 24px、手机 20px），加载失败会自动换另一套
#   （两套都失败才退回纯文字），不会留下破图。
# REFRESH_INTERVAL_SECONDS：前端自动刷新间隔（默认 180 秒，即 3 分钟）
#   允许范围 10–3600 秒：过小会打爆上游配额，过大则「自动刷新」形同虚设。
#   页面隐藏时自动暂停，这是浏览器行为，不受该变量影响。
# SITE_NAME=内部用量面板
# SITE_LOGO_URL=https://cdn.example.com/logo.svg
# SITE_LOGO_URL_DARK=https://cdn.example.com/logo-dark.svg
# SITE_FAVICON_URL=https://cdn.example.com/favicon.png
# REFRESH_INTERVAL_SECONDS=180
