# ============================================================
# 多账号支持：第 1 组使用基础变量名，第 N 组使用 _N 后缀（连续编号）。
# 账号别名（可选，多 Key 强烈建议）：*_LABEL / *_LABEL_N 按**同序号**与凭据配对，
# 卡片主标题显示别名，Key 掩码退居次要位置。未配别名时主标题直接显示 Key 掩码。
# 例：
#   OPENCODE_GO_API_KEY_2=sk-xxxx
#   OPENCODE_GO_LABEL_2=后端团队专用
# ============================================================
# 例如 DeepSeek 第二/三个账号：
#   DEEPSEEK_API_KEY_2=sk-xxxx
#   DEEPSEEK_API_KEY_3=sk-xxxx
# 成对凭据（如 VOLC_ACCESS_KEY_ID + VOLC_SECRET_KEY）同编号成组：
#   VOLC_ACCESS_KEY_ID_2=AKLTxxxx
#   VOLC_SECRET_KEY_2=xxxx
# ============================================================
# DeepSeek 余额查询
DEEPSEEK_API_KEY=sk-xxxx

# 火山方舟 管控面 API（Agent Plan / Coding Plan 用量）
# Access Key 在 https://console.volcengine.com/iam/keymanage 创建（推荐 IAM 子用户）
VOLC_ACCESS_KEY_ID=AKLTxxxx
VOLC_SECRET_KEY=xxxx

# 智谱开放平台（GLM 资源包 / 余额）
# API Key 在 https://open.bigmodel.cn/usercenter/apikeys 创建
ZHIPU_API_KEY=xxxxx.xxxxx

# 阿里云百炼 Token 资源包（BSS 费用中心）+ Token Plan 组织/座席
# AccessKey 在 https://ram.console.aliyun.com/manage/ak 创建（推荐 RAM 子用户 + 只读权限）
# Token Plan 组织/座席区块需要 AliyunTokenPlanReadOnlyAccess。
ALIYUN_ACCESS_KEY_ID=LTAIxxxx
ALIYUN_SECRET_KEY=xxxx

# 阿里云百炼 Token Plan **个人版**用量（可选，推荐）
# 只需百炼控制台的会话 Cookie，**无需 AK/SK、无需任何 RAM 授权**：
#   1. 登录 https://bailian.console.aliyun.com
#   2. DevTools → Application → Cookies → bailian.console.aliyun.com
#   3. 复制 `login_aliyunid_ticket` 的**值**（粘值即可，别粘整段 Cookie 头）
# 会话过期（通常数周）后需重新复制；多账号用 _2 / _3 后缀与 AK/SK 同序号配对。
#
# ⚠️ 本地 .env 里的字面 $ 必须转义成 \$ ！
#   该 ticket 值含 $（形如 …M_1t$w3j6$SFnA3gvT*…），而 .env 加载器会做 $VAR 变量展开，
#   未转义时这两段会被当成变量名、静默展开为空，值损坏且报错与「会话过期」完全同形。
#   加引号（"…" / '…'）无效，必须用 \$。
#   👉 平台面板（Vercel / EdgeOne / Workers）相反：直接粘原值，不要加反斜杠。
#
# ❌ 错误：ALIYUN_TOKENPLAN_COOKIE=…M_1t$w3j6$SFnA3gvT*…
# ✅ 正确：ALIYUN_TOKENPLAN_COOKIE=…M_1t\$w3j6\$SFnA3gvT*…
# ALIYUN_TOKENPLAN_COOKIE=
# 个人版账号别名（可选）：ALIYUN_TOKENPLAN_LABEL=个人版主号
# 注意：没有 AK/SK 时 ALIYUN_LABEL 找不到配对项，别名会被忽略，请用上面这个变量。
#
# 别名对照（按同序号配对）：
#   DEEPSEEK_LABEL / VOLC_LABEL / ZHIPU_LABEL / ALIYUN_LABEL / GITEE_LABEL /
#   BAIDU_LABEL / ALIYUN_TOKENPLAN_LABEL / STEPFUN_LABEL / SILICONFLOW_LABEL /
#   OPENROUTER_LABEL / NOVITA_LABEL / KIMI_LABEL / MINIMAX_LABEL / OPENCODE_GO_LABEL /
#   NEWAPI_LABEL

# 若不使用 Cookie，可改用 AK/SK 路径查询个人版用量，但需 RAM 自定义策略授予
# modelstudio:GenerateCLIAccessToken（详见 README「阿里云百炼 Token Plan」）。

# 模力方舟（Gitee AI）资源包余额
# 访问令牌在 https://ai.gitee.com 生成
GITEE_AI_API_KEY=UC03xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 代金券查询（可选）：ai.gitee.com 登录后的会话 Cookie（DevTools → Application → Cookies，
# 复制整行 Cookie 请求头；约 30 天过期，过期后重新登录并更新；多账号同 _N 后缀配对）
# GITEE_AI_SESSION_COOKIE=user_locale=zh-CN; __Secure-next-auth.session-token=xxxx-xxxx

# 扩展平台（可选，配置哪个显示哪个）
# 余额类 → 「扩展平台」Tab：StepFun 阶跃星辰 https://platform.stepfun.com
STEPFUN_API_KEY=
# SiliconFlow 硅基流动：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=
# OpenRouter：https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Novita AI：https://novita.ai
NOVITA_API_KEY=
# 套餐类 → 「套餐订阅」Tab（按窗口计的订阅额度）：Kimi For Coding https://platform.moonshot.cn
KIMI_API_KEY=
# MiniMax：https://platform.minimaxi.com
MINIMAX_API_KEY=
# OpenCode Go 订阅额度（rolling 5h / weekly 7d / monthly 30d）：https://opencode.ai
OPENCODE_GO_API_KEY=

# New API（自托管大模型网关，站点地址 + **系统访问令牌**成对配置）
#
# NEWAPI_TOKEN 填的是**系统访问令牌**，不是 `sk-` 开头的模型调用密钥：
#   1. 登录你的 New API 站点
#   2. 「个人设置 → 安全设置 → 系统访问令牌」→ 生成
#   3. 把生成的令牌整串粘到 NEWAPI_TOKEN
#   官方文档：https://docs.newapi.ai/zh/docs/api/management/auth
#   请求头形如 `Authorization: Bearer {token}`，部分站点还需要 `New-Api-User`
#   （管理员代查他人数据时填，个人自查可省略，见 NEWAPI_USER_ID）。
#
# 令牌能读**管理接口**，字段最全：用户名 / 分组 / 按模型用量 / 订阅模式判定 /
# 以及站点自己的额度单位（站点用 USD 之外的币种时也能正确显示单位）。
# 误填 `sk-` 密钥不会报错，但会静默退化到账单接口（只有钱包余额，没有用户名与模型明细）。
# 多站点按 _2 / _3 追加；NEWAPI_USER_ID / NEWAPI_LABEL 与 BASE_URL 同序号配对。
NEWAPI_BASE_URL=https://ai.example.com/
NEWAPI_TOKEN=
# NEWAPI_USER_ID=
# NEWAPI_LABEL=主力站

# 服务监听地址（默认 127.0.0.1:8787，仅本机可访问）
# HOST=0.0.0.0
# PORT=8787

# 站点自定义（全部可选，只影响页面外观与刷新节奏，不参与鉴权）
#
# 为什么走环境变量而不是前端构建期变量：同一份构建产物要跑在 Bun / Cloudflare
# Workers / EdgeOne / Vercel 四种宿主上，而部署流程让用户在平台面板里配的就是
# **运行时**变量。用构建期变量会变成「改个站点名要重新构建并重传产物」。
#
# SITE_NAME：导航栏品牌位 + 浏览器标签页标题（默认「LLM 用量监控」）
# SITE_LOGO_URL：导航栏 Logo 图片地址，未配置则只显示文字标题
# SITE_FAVICON_URL：标签页图标地址，未配置则保留自带的 /favicon.ico
#   两者都由浏览器直接加载（不经服务端代理），因此**不受 CORS 限制**；
#   但必须是 https —— http 资源在 https 页面上会被按混合内容拦掉。
#   建议用长方形或方形、深色/浅色都看得清的图；加载失败会自动退回纯文字，
#   不会留下破图。
# REFRESH_INTERVAL_SECONDS：前端自动刷新间隔（默认 180 秒，即 3 分钟）
#   允许范围 10–3600 秒：过小会打爆上游配额，过大则「自动刷新」形同虚设。
#   页面隐藏时自动暂停，这是浏览器行为，不受该变量影响。
# SITE_NAME=内部用量面板
# SITE_LOGO_URL=https://cdn.example.com/logo.svg
# SITE_FAVICON_URL=https://cdn.example.com/favicon.png
# REFRESH_INTERVAL_SECONDS=180
