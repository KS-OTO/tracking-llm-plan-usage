# ============================================================
# 多账号支持：第 1 组使用基础变量名，第 N 组使用 _N 后缀（连续编号）。
# 账号别名（可选）：*_LABEL 与同序号 Key 配对（如 DEEPSEEK_LABEL_2=公司号），
# 无别名时前端显示「账号 N + 掩码」。
# ============================================================
# 例如 DeepSeek 第二/三个账号：
#   DEEPSEEK_API_KEY_2=sk-xxxx
#   DEEPSEEK_API_KEY_3=sk-xxxx
# 成对凭据（如 VOLC_ACCESS_KEY_ID + VOLC_SECRET_KEY）同编号成组：
#   VOLC_ACCESS_KEY_ID_2=AKLTxxxx
#   VOLC_SECRET_KEY_2=xxxx
# ============================================================
# DeepSeek 余额查询
DEEPSEEK_API_KEY=sk-xxxx

# 火山方舟 管控面 API（Agent Plan / Coding Plan 用量）
# Access Key 在 https://console.volcengine.com/iam/keymanage 创建（推荐 IAM 子用户）
VOLC_ACCESS_KEY_ID=AKLTxxxx
VOLC_SECRET_KEY=xxxx

# 智谱开放平台（GLM 资源包 / 余额）
# API Key 在 https://open.bigmodel.cn/usercenter/apikeys 创建
ZHIPU_API_KEY=xxxxx.xxxxx

# 阿里云百炼 Token 资源包（BSS 费用中心）+ Token Plan 组织/座席
# AccessKey 在 https://ram.console.aliyun.com/manage/ak 创建（推荐 RAM 子用户 + 只读权限）
# Token Plan 组织/座席区块需要 AliyunTokenPlanReadOnlyAccess。
ALIYUN_ACCESS_KEY_ID=LTAIxxxx
ALIYUN_SECRET_KEY=xxxx

# 阿里云百炼 Token Plan **个人版**用量（可选，推荐）
# 只需百炼控制台的会话 Cookie，**无需 AK/SK、无需任何 RAM 授权**：
#   1. 登录 https://bailian.console.aliyun.com
#   2. DevTools → Application → Cookies → bailian.console.aliyun.com
#   3. 复制 `login_aliyunid_ticket` 的值（实测仅此一个 Cookie 即可，其余非必需）
# 两种写法都接受：裸 ticket 值，或整段 Cookie 头（login_aliyunid_ticket=xxx; ...）。
# 会话过期（通常数周）后需重新复制；多账号用 _2 / _3 后缀与 AK/SK 同序号配对。
# ALIYUN_TOKENPLAN_COOKIE=eyJ0aWNrZXQ...（示意，勿照抄）

# 若不使用 Cookie，可改用 AK/SK 路径查询个人版用量，但需 RAM 自定义策略授予
# modelstudio:GenerateCLIAccessToken（详见 README「阿里云百炼 Token Plan」）。

# 模力方舟（Gitee AI）资源包余额
# 访问令牌在 https://ai.gitee.com 生成
GITEE_AI_API_KEY=UC03xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 代金券查询（可选）：ai.gitee.com 登录后的会话 Cookie（DevTools → Application → Cookies，
# 复制整行 Cookie 请求头；约 30 天过期，过期后重新登录并更新；多账号同 _N 后缀配对）
# GITEE_AI_SESSION_COOKIE=user_locale=zh-CN; __Secure-next-auth.session-token=xxxx-xxxx

# 扩展平台（可选，配置哪个显示哪个）
# StepFun 阶跃星辰：https://platform.stepfun.com
STEPFUN_API_KEY=
# SiliconFlow 硅基流动：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=
# OpenRouter：https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Novita AI：https://novita.ai
NOVITA_API_KEY=
# Kimi For Coding：https://platform.moonshot.cn
KIMI_API_KEY=
# MiniMax：https://platform.minimaxi.com
MINIMAX_API_KEY=
# OpenCode Go 订阅额度（rolling 5h / weekly 7d / monthly 30d）：https://opencode.ai
OPENCODE_GO_API_KEY=

# 服务监听地址（默认 127.0.0.1:8787，仅本机可访问）
# HOST=0.0.0.0
# PORT=8787
