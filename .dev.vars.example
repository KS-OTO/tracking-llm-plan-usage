# Cloudflare Workers 本地调试变量（.dev.vars，勿提交）
# 生产环境请用 wrangler secret put <NAME> 配置
# 多账号：变量名加 _2/_3 后缀（连续编号）
# 账号别名：*_LABEL / *_LABEL_N 按同序号配对，卡片优先展示别名
DEEPSEEK_API_KEY=sk-xxxx
VOLC_ACCESS_KEY_ID=AKLTxxxx
VOLC_SECRET_KEY=xxxx
ZHIPU_API_KEY=xxxxx.xxxxx
ALIYUN_ACCESS_KEY_ID=LTAIxxxx
ALIYUN_SECRET_KEY=xxxx
# Token Plan 个人版用量（可选）：百炼控制台 Cookie 里 login_aliyunid_ticket 的「值」，无需 RAM 授权
# ⚠️ 本地文件里的字面 $ 必须写成 \$（加载器会做 $VAR 展开，否则值被静默截断）；
#    平台面板（Vercel / EdgeOne / Workers Secret）则直接粘原值、不要加反斜杠。
# ALIYUN_TOKENPLAN_COOKIE=
# Cookie 专属账号的别名（无 AK/SK 时 ALIYUN_LABEL 会被忽略）
# ALIYUN_TOKENPLAN_LABEL=
GITEE_AI_API_KEY=UC03xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 代金券查询（可选）：ai.gitee.com 会话 Cookie（约 30 天过期）
# GITEE_AI_SESSION_COOKIE=__Secure-next-auth.session-token=xxxx-xxxx

# 余额类扩展平台（「扩展平台」Tab）
STEPFUN_API_KEY=
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
NOVITA_API_KEY=
# 套餐类扩展平台（「套餐订阅」Tab）
KIMI_API_KEY=
MINIMAX_API_KEY=
OPENCODE_GO_API_KEY=
# 例：OPENCODE_GO_LABEL=前端团队专用订阅

# New API（自托管网关，站点地址 + **系统访问令牌**成对配置；管理接口优先、账单接口回落）
# NEWAPI_TOKEN 填「个人设置 → 安全设置 → 系统访问令牌」生成的令牌，
# **不是** `sk-` 开头的模型调用密钥（误填会静默退化为账单接口，字段变少）。
# 文档：https://docs.newapi.ai/zh/docs/api/management/auth
NEWAPI_BASE_URL=https://ai.example.com/
NEWAPI_TOKEN=
# NEWAPI_USER_ID=
# NEWAPI_LABEL=主力站

BAIDU_ACCESS_KEY_ID=ALTAKxxxx
BAIDU_SECRET_KEY=xxxx

# 站点自定义（可选，纯前端外观）：
#   SITE_NAME                 品牌名（导航栏 + 标签页标题），默认「LLM 用量监控」；
#                             显式留空 = 只显示 Logo（适合 Logo 已是完整字标）
#   SITE_LOGO_URL             明亮模式 Logo 地址（浏览器直连，不受 CORS 限制，但须 https）
#   SITE_LOGO_URL_DARK        暗黑模式 Logo 地址；不配则暗黑模式沿用 SITE_LOGO_URL
#   SITE_FAVICON_URL          标签页图标地址（同上；未配置保留自带 /favicon.ico）
#   REFRESH_INTERVAL_SECONDS  自动刷新间隔秒数，默认 180，允许 10–3600
# SITE_NAME=内部用量面板
# SITE_LOGO_URL=https://cdn.example.com/logo.svg
# SITE_LOGO_URL_DARK=https://cdn.example.com/logo-dark.svg
# SITE_FAVICON_URL=https://cdn.example.com/favicon.png
# REFRESH_INTERVAL_SECONDS=180
